{
  ".source.scala": {
    "bracket-matcher": {
      "autocompleteCharacters": ["()", "[]", "{}", "\"\"", "''"],
      "autocompleteDisabledCharacters": ["'"]
    },
    "editor": {
      "commentStart": "// ",
      "commentDelimiters": {
        "line": "//",
        "block": ["/*", "*/"]
      }
    }
  }
}
